<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the NexusWpp icons from branding\*.svg (icon.ico, branding\png, dist\store-logos), in .NET with Svg.Skia
       instead of Python and cairosvg: dotnet run with this project. Build output goes to work\. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\work\tools\ExportIcons\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

</Project>