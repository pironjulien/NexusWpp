<Project Sdk="Microsoft.NET.Sdk">

  <!-- A/B graphics profile of the wallpaper in an isolated WebView2 (scripts\profile_graphics.ps1): a real
       project with the host's runtime, packages and analysis, warnings as errors. Build output goes to work\. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\work\tools\GraphicsProfile\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as NexusWpp.csproj. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- As in the host: the WinForms control only, not the WPF one. -->
  <Target Name="TrimWebView2Output" AfterTargets="ResolveLockFileReferences;ResolvePackageAssets;ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
