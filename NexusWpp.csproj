<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET 10 Windows desktop, self-contained: the Store and the installer ship the runtime with
       the app, so users have nothing to install. The Windows 10 SDK projection brings the WinRT
       StartupTask API of the Store package (PriorityStartup.cs). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-monitor v2: real pixels on every monitor, no bitmap stretching on mixed-DPI setups.
         Applied by ApplicationConfiguration.Initialize() in Program.cs. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Recommended .NET analyzers and the build-time code-style rules of .editorconfig, all errors
         (TreatWarningsAsErrors). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- LibraryImport generates pinning code; native structures are read in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <AssemblyName>nexuswpp</AssemblyName>
    <RootNamespace>NexusWpp</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Version attributes come from the VERSION stamp (compile.ps1); the SDK still declares the target platform. -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- The compiler's documentation pass lets IDE0005 (unnecessary using) run at build time;
         the XML file itself is neither copied next to the exe nor published. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- Nor the IntelliSense files of the packages (Microsoft.Web.WebView2.*.xml): the app never reads them. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Precompiled host code: a faster first start at sign-in (the runtime itself is already precompiled). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ReleaseVersionSource>work\obj\ReleaseVersion.cs</ReleaseVersionSource>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every C# file at the project root belongs to the host. -->
    <Compile Include="*.cs" />
    <Compile Include="$(ReleaseVersionSource)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Ship only what the WinForms host loads: no WPF control, no duplicate loader tree
       (WebView2Loader.dll already sits next to the exe). -->
  <Target Name="RemoveDuplicateLoaderTree" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)runtimes" />
  </Target>
  <Target Name="RemoveDuplicateLoaderTreeFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes'))" />
    </ItemGroup>
  </Target>
  <Target Name="TrimWebView2Output" AfterTargets="ResolveLockFileReferences;ResolvePackageAssets;ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
