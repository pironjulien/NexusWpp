<Project Sdk="Microsoft.NET.Sdk">

  <!-- C# tests of NexusWpp (xUnit v3 on Microsoft Testing Platform, run by `dotnet test` from test.ps1 and the CI):
       every host source compiled here, with the host's analysis (nullable, recommended analyzers, code style, warnings
       as errors) and its DPI mode. The WinForms and WebView2 harnesses (Harnesses\) run off screen and never activated;
       the ones that need the real desktop are explicit tests (README "Tests"). Build output goes to work\. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Same as NexusWpp.csproj (checked by HostSourceTests): ApplicationConfiguration.Initialize() in TestEntryPoint. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NexusWpp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Own entry point (TestEntryPoint.cs): the host test needs a child process of this executable, and the host's
         Program.Main is compiled here too. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <StartupObject>NexusWpp.Tests.TestEntryPoint</StartupObject>
    <!-- The version attributes come from the VERSION stamp, as in the host. -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BaseOutputPath>$(NexusWppRoot)work\tests\bin\</BaseOutputPath>
    <!-- The host's version stamp, written from VERSION by Directory.Build.targets. -->
    <ReleaseVersionSource>$(BaseIntermediateOutputPath)ReleaseVersion.cs</ReleaseVersionSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NexusWppRoot)*.cs" Link="Host\%(Filename)%(Extension)" />
    <Compile Include="$(ReleaseVersionSource)" Link="Host\ReleaseVersion.cs" />
    <Using Include="Xunit" />
    <AssemblyMetadata Include="NexusWpp.Repository" Value="$(NexusWppRoot)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- As in the host: the WinForms control only, not the WPF one. -->
  <Target Name="TrimWebView2Output" AfterTargets="ResolveLockFileReferences;ResolvePackageAssets;ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
