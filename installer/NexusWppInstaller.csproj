<Project Sdk="Microsoft.NET.Sdk">

  <!-- One self-contained, compressed NexusWppSetup.exe on .NET 10: it runs on a bare Windows
       with nothing installed. The application payload (NexusWppPayload.zip, made by
       scripts/build_installer.ps1) is embedded as a resource. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Same analysis as the host (NexusWpp.csproj): recommended analyzers and the code-style rules
         of .editorconfig, all errors. The documentation pass only serves IDE0005 and is not shipped. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- LibraryImport (wintrust, user32) passes pinned buffers and structures by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>NexusWppSetup</AssemblyName>
    <RootNamespace>NexusWppInstaller</RootNamespace>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <ApplicationManifest>NexusWppInstaller.manifest</ApplicationManifest>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PayloadZip Condition="'$(PayloadZip)' == ''">..\dist\NexusWppPayload.zip</PayloadZip>
    <!-- The host's version stamp, written from VERSION by Directory.Build.targets. -->
    <ReleaseVersionSource>$(BaseIntermediateOutputPath)ReleaseVersion.cs</ReleaseVersionSource>
    <!-- NuGet restore pinned by packages.lock.json (direct and transitive packages, content hashes); CI and release
         restore in locked mode, so a dependency never changes without a committed lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Microsoft.NET.ILLink.Tasks is pinned on purpose (see there): its "delete explicit reference" notice is answered. -->
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NexusWppInstaller.cs" />
    <Compile Include="$(ReleaseVersionSource)" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="NexusWpp.Payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
    <!-- The trimmer's tasks, which the self-contained single-file build adds: pinned like any package
         (packages.lock.json, Dependabot); left implicit, their version would follow the .NET SDK of the machine and
         break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
  </ItemGroup>

</Project>
